# Ambientes virtuais Python (backend)
backend_test_venv/
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Arquivos de demonstração baixados pelo pylinac
demo_files/

# Banco de dados local do backend (dados reais do usuário, não versionar)
backend/rtqc.db
backend/rtqc.db-journal

# Configuração local (caminho da pasta de backup automático, específico da máquina)
backend/rtqc_config.json

# Arquivos enviados pelo usuário (certificados de calibração de Ativos) —
# dados reais, não versionar; ver README.md sobre incluir esta pasta no
# backup manual, já que o backup/export só leva os metadados.
backend/uploads/
